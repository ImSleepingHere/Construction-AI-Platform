# Database
POSTGRES_USER=construction_ai
POSTGRES_PASSWORD=changeme_in_real_env
POSTGRES_DB=construction_ai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# LLM Provider
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# App
APP_ENV=development
APP_SECRET_KEY=change_this_to_a_long_random_string
LOG_LEVEL=INFO